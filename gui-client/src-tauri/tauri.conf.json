{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Sync",
  "mainBinaryName": "claude-sync-gui",
  "version": "0.1.0",
  "identifier": "com.claude-sync.gui",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "assetProtocol": {
        "scope": ["$HOME/.claude-sync/**", "$HOME/.claude/**"]
      }
    },
    "windows": [
      {
        "label": "main",
        "title": "Claude Sync",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "category": "Developer Tool",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
